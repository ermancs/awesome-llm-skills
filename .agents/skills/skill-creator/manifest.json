{
  "id": "skill-creator",
  "name": "Skill Creator (Gold Standard)",
  "version": "2.0.0",
  "author": "Hermes Agent",
  "license": "MIT",
  "runtime": {
    "min_model_tier": "sonnet-class",
    "context_window_required": 32000,
    "languages": ["en", "tr"]
  },
  "entry_point": "src/main.py",
  "tools": [],
  "dependencies": {
    "python": ">=3.11",
    "packages": ["pyyaml>=6.0"]
  },
  "evals": {
    "pass_rate": null,
    "last_run": null
