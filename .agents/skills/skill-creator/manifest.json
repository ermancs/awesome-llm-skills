  "tags": ["skills", "authoring", "evaluation", "benchmarking", "testing", "skill-creator", "conventions", "gold-standard", "meta"],
  "security": {
    "allow_network": false,
    "allow_file_write": true,
    "blocked_paths": ["/etc", "/sys", "~/.ssh"],
    "max_cost_per_call": 5.0
  }
